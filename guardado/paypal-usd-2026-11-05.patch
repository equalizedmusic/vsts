+// reconsulta de hora em hora (cron): o PayPal não avisa o servidor. Se o comprador aprovou e fechou a página antes de
+// voltar, ou se a captura ficou PENDING (conta vendedora em aceite manual, análise), ninguém mais conferiria. Aqui o
+// servidor captura/relê cada pedido PayPal em aberto e, quando estiver COMPLETED, gera a licença e manda o e-mail.
+//   - 'criado'/'pendente' dentro do prazo de 4 dias (comprador pode aprovar a qualquer momento);
+//   - já capturado (pagamento_id preenchido) até 30 dias, mesmo 'vencido': o dinheiro saiu, a licença tem que sair.
+const RECONSULTA_MAX = 40;   // por rodada (cada um custa 2-3 chamadas ao PayPal)
+const CAPTURADO_ATE = 30 * 86400;
+export async function reconsultarPaypal(env, agora, h, base) {
+    if (!ppLigado(env)) return 0;
+    const { results = [] } = await env.DB.prepare(
+        "SELECT * FROM pedidos WHERE metodo = 'paypal' AND ref IS NOT NULL AND ref <> '' AND (" +
+        "(status IN ('criado', 'pendente') AND criado_em >= ?) OR " +
+        "(status IN ('pendente', 'vencido') AND pagamento_id IS NOT NULL AND criado_em >= ?) OR " +
+        "(status = 'processando' AND pago_em < ?)) ORDER BY criado_em DESC LIMIT ?")
+        .bind(agora - PRAZO, agora - CAPTURADO_ATE, agora - PRESO, RECONSULTA_MAX).all();
+    const url = new URL(base);
+    let pagos = 0;
+    for (const pedido of results) {
+        try {
+            const conf = await conferirPaypal(env, pedido);
+            // pedido que nunca foi aprovado continua como está (não vira 'pendente' só porque o cron passou)
+            if (conf.status === 'pendente' && !conf.pagamento) continue;
+            if (pedido.status === 'vencido' && conf.status !== 'pago') continue;
+            if (await aplicar(env, url, h, pedido, conf) === 'pago') pagos++;
+        } catch (e) { console.error('loja: reconsulta paypal', pedido.id, e); }
+    }
+    if (results.length) console.log('loja: reconsulta paypal', results.length, 'em aberto,', pagos, 'pagos agora');
+    return pagos;
+}
+
